# Multi-View RAG Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Neo4j Configuration
# ===========================================
NEO4J_URI=bolt://localhost:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# ===========================================
# OpenAI API (REQUIRED for LLM generation and embeddings)
# ===========================================
# Single key:
OPENAI_API_KEY=sk-your-key-here
# Multiple keys (comma-separated) for rate limit distribution:
# OPENAI_API_KEY=sk-key1...,sk-key2...,sk-key3...

# ===========================================
# LangSmith Observability (OPTIONAL)
# ===========================================
# Tracing of all LLM calls and pipeline stages. Leave empty to disable.
# Get a key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=parliamentrag

# ===========================================
# Brevo mailing list (OPTIONAL)
# ===========================================
# Newsletter opt-in in the answer feedback dialog. Leave the key empty to
# hide it. The list collects confirmed contacts; the template is a Brevo
# double opt-in template containing the {{ doubleoptin }} link.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
PUBLIC_SITE_URL=https://www.parliamentrag.it

# ===========================================
# Application Settings
# ===========================================
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# User data retention (privacy notice): questions, answers, feedback and
# surveys are deleted after this date, Europe/Rome. Optional max age in days.
# DATA_RETENTION_UNTIL=2027-12-31
# DATA_RETENTION_MAX_DAYS=

# ===========================================
# Frontend Settings
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ===========================================
# NOTES
# ===========================================
# - This system uses OpenAI for all LLM inference
# - Neo4j database should be running on the specified URI
# - For production, use secure passwords and HTTPS
